#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Install Azure CLI
curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# Install Docker
apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
cat <<EOF >/etc/apt/sources.list.d/docker.list

deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release; echo $VERSION_CODENAME) stable
EOF
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
usermod -aG docker ${vm_admin_username}
chmod 666 /var/run/docker.sock

# Authenticate Azure CLI using the VM's system-assigned managed identity.
# This avoids long-lived secrets and prevents them from appearing in cloud-init logs.
az login --identity >/dev/null
az account set --subscription "${subscription_id}"
az acr login --name "${acr_name}"

# Optionally install and register a GitHub self-hosted runner
if [ "${github_runner_enabled}" = "true" ] && [ -n "${github_runner_url}" ] && [ -n "${github_runner_token}" ]; then
  RUNNER_HOME="/home/${vm_admin_username}/actions-runner"
  mkdir -p "$RUNNER_HOME"
  chown -R ${vm_admin_username}:${vm_admin_username} "$RUNNER_HOME"

  sudo -u ${vm_admin_username} bash -lc "
    set -euo pipefail
    cd \"$RUNNER_HOME\"
    curl -fsSL -o actions-runner-linux-x64.tar.gz -L https://github.com/actions/runner/releases/download/v2.337.0/actions-runner-linux-x64-2.337.0.tar.gz
    tar xzf actions-runner-linux-x64.tar.gz
    ./config.sh --url '${github_runner_url}' --token '${github_runner_token}' --name '${github_runner_name}' --work _work --labels '${github_runner_labels}' --unattended
    nohup ./run.sh > /tmp/actions-runner.log 2>&1 &
  "
fi
